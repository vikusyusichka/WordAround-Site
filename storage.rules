rules_version = '2';

/* WordAround Cloud Storage rules — RECONCILED WITH LIVE.
 *
 * Checked against the project on the day Storage was first enabled: the live
 * rules were Firebase's default lock (deny everything), so this file replaces
 * them wholesale with nothing lost. Storage did not exist on the project until
 * then — which is why card-image upload had never worked, and why the CORS
 * theory in DEPLOY.md was a misdiagnosis.
 *
 * Only the WEB app uses Storage (the iOS app does not touch it at all), and it
 * writes two kinds of object — flashcard card images and note-block images:
 *
 *   users/{uid}/setImages/{setId}/{cardId}.jpg
 *     (src/lib/setImageService.ts — downscaled to max 1024px and re-encoded
 *      as JPEG client-side before upload)
 *
 *   users/{uid}/noteImages/{topicId}/{noteId}/{blockId}.jpg
 *     (src/lib/noteImageService.ts — image blocks inside grammar notes,
 *      downscaled to max 1400px)
 *
 * Bucket: wordaround-97f86.firebasestorage.app, us-east1 (the no-cost
 * location). The region is permanent; moving it means a new bucket.
 *
 * Note on reads: the app stores the `getDownloadURL()` result in card.imageURL.
 * Those URLs carry a Firebase download token that grants access to that single
 * object regardless of these rules — that is how Firebase is designed, and it
 * is why images keep loading in <img> tags. The read rule below still matters:
 * it stops anyone from browsing or guessing other users' objects without a
 * token. Treat any image whose URL leaks as effectively public.
 */

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isReasonableImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/setImages/{setId}/{fileName} {
      allow read: if isOwner(uid);
      /* Size + type are validated because this is the one path the client can
         push arbitrary bytes to; the app always sends a downscaled JPEG well
         under the limit, so this cannot break normal use. */
      allow write: if isOwner(uid) && isReasonableImage();
      allow delete: if isOwner(uid);
    }

    /* Images inside grammar-note image blocks (src/lib/noteImageService.ts),
       downscaled to 1400px and re-encoded as JPEG client-side. */
    match /users/{uid}/noteImages/{topicId}/{noteId}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isReasonableImage();
      allow delete: if isOwner(uid);
    }

    /* Default deny — nothing else may be read or written. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
